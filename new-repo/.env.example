# Google AI
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# SharePoint / Microsoft Graph (customer-owned app registration)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
